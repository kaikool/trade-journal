# ==============================================================================
# Trade Journal Environment Variables (Supabase & Vercel)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Transaction pooler URL (recommended for Vercel serverless functions, port 6543)
# Format: postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&supa=base-pooler.x
DATABASE_URL=

# Direct database connection URL (session pooler or direct DB port 5432, used for migrations with drizzle-kit)
# Format: postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. Supabase Storage Configuration
# ------------------------------------------------------------------------------
# Supabase project URL
# Found in Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=

# Supabase Service Role Key (secret key, never expose on client-side)
# Found in Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
# Secret passphrase used to derive AES-256-GCM encryption keys for broker credentials and AI keys at rest.
# MUST remain stable across deployments. Generate a strong key: openssl rand -hex 32
JOURNAL_SECRET=

# Password required to log in to the journal (single-user authentication).
# Required in every environment. Missing, empty, or whitespace-only values block access with HTTP 503.
# Generate a strong password with: openssl rand -hex 32
# Keep it server-side; changing it invalidates all existing sessions.
# Signed sessions expire after 30 days; rotating this password invalidates them.
# Login permits 10 attempts per minute across instances, using PostgreSQL.
JOURNAL_PASSWORD=

# Vercel Cron authentication for daily broker auto-sync (at least 16 random characters)
CRON_SECRET=

# ------------------------------------------------------------------------------
# 4. Optional AI Configuration
# ------------------------------------------------------------------------------
# Environment keys take precedence over keys saved in Settings -> AI.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 5. Optional Legacy SQLite Path (Used for migration CLI: pnpm migrate:supabase)
# ------------------------------------------------------------------------------
# JOURNAL_SQLITE_PATH=./data/journal.db

# Apply database migrations before deploying upgrades: pnpm --filter web db:migrate
# Journal tables use RLS with no public policies. DATABASE_URL must use a trusted
# server role that owns the tables or has BYPASSRLS (Supabase postgres role).
# Candle CSV commits require SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.

# Optional The5ers read-only MCP connection. Leave client ID empty for CIMD/DCR discovery.
# Automatic registration requires provider support and callback approval.
THE5ERS_OAUTH_CLIENT_ID=
# Only for a confidential client; never expose it to the browser.
THE5ERS_OAUTH_CLIENT_SECRET=
# Optional; otherwise use Vercel production origin (or request origin outside Vercel).
THE5ERS_REDIRECT_URI=
# Leave both empty for discovery. Overrides require a pre-registered client ID.
# Only https://auth.hub.the5ers.com is accepted. Do not guess endpoint paths.
THE5ERS_AUTHORIZATION_URL=
THE5ERS_TOKEN_URL=
