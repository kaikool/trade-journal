# ==============================================================================
# Trade Journal Environment Variables (Supabase & Vercel)
# ==============================================================================

# Database Configuration (Supabase PostgreSQL)
# Transaction pooler connection string (port 6543)
DATABASE_URL=
# Direct connection string for migrations (port 5432)
DIRECT_DATABASE_URL=

# Supabase Storage Configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Security & Authentication
# Key derivation for AES-256-GCM encryption (generate via: openssl rand -hex 32)
JOURNAL_SECRET=
# Login password for the journal
JOURNAL_PASSWORD=

# Optional AI Configuration
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
