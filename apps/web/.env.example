# ==============================================================================
# Trade Journal Environment Variables (Supabase & Vercel)
# ==============================================================================

# Database Configuration (Supabase PostgreSQL)
# Transaction pooler connection string (port 6543)
DATABASE_URL=
# Direct connection string for migrations (port 5432)
DIRECT_DATABASE_URL=

# Supabase Storage Configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Security & Authentication
# Key derivation for AES-256-GCM encryption (generate via: openssl rand -hex 32)
JOURNAL_SECRET=
# Required login password. Missing, empty, or whitespace-only values block access with HTTP 503.
# Generate a strong password with: openssl rand -hex 32
# Keep it server-side; changing it invalidates all existing sessions.
JOURNAL_PASSWORD=

# Vercel Cron authentication for daily broker auto-sync (at least 16 random characters)
CRON_SECRET=

# Optional AI Configuration
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
